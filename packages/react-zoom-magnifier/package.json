{
  "name": "react-zoom-magnifier",
  "version": "0.1.0",
  "description": "An application-level magnifier / zoom lens for React and Next.js",
  "keywords": [
    "react",
    "nextjs",
    "zoom",
    "magnifier",
    "magnify",
    "lens",
    "image-zoom",
    "accessibility"
  ],
  "homepage": "https://github.com/iamtanmayrudra/zoomers/tree/main/packages/react-zoom-magnifier#readme",
  "bugs": {
    "url": "https://github.com/iamtanmayrudra/zoomers/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iamtanmayrudra/zoomers.git",
    "directory": "packages/react-zoom-magnifier"
  },
  "license": "MIT",
  "author": "iamtanmayrudra",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/zoom.css"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node -e \"require('fs').copyFileSync('src/styles/zoom.css','dist/zoom.css')\"",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "html2canvas": "^1.4.1"
  },
  "peerDependenciesMeta": {
    "html2canvas": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "html2canvas": "^1.4.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
